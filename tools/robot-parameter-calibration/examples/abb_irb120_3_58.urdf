<?xml version="1.0"?>
<!--
  SPDX-License-Identifier: Apache-2.0

  Kinematics-only, expanded URDF for the ABB IRB 120-3/0.6 example.

  Adapted from ROS-Industrial abb_irb120_support/urdf/
  irb120_3_58_macro.xacro (Apache-2.0):
  https://github.com/ros-industrial/abb/blob/noetic/
  abb_irb120_support/urdf/irb120_3_58_macro.xacro

  Robotics Workbench modified the upstream Xacro as follows: expanded the empty
  prefix and radians(90) expressions; removed Xacro/material definitions,
  visual, collision and inertial elements; removed the auxiliary base frame
  branch; reparented tool0 from link_6 to the identity-coincident flange and
  renamed that fixed joint from link_6-tool0 to flange-tool0; and changed the
  robot name. No motion-joint origin, axis or default limit was changed, and
  the net link_6→flange and link_6→tool0 transforms remain unchanged.

  The complete license text is in ABB_IRB120_LICENSE.txt and detailed
  provenance is in ABB_IRB120_ATTRIBUTION.md.

  Verify limits and configuration against the exact physical controller before
  using any result on hardware. ABB is a trademark of ABB Asea Brown Boveri Ltd.
-->
<robot name="abb_irb120_3_58_kinematics_demo">
  <link name="base_link"/>
  <link name="link_1"/>
  <link name="link_2"/>
  <link name="link_3"/>
  <link name="link_4"/>
  <link name="link_5"/>
  <link name="link_6"/>
  <link name="flange"/>
  <link name="tool0"/>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.87979" upper="2.87979" effort="0" velocity="4.36332"/>
  </joint>

  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0 0.29" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.91986" upper="1.91986" effort="0" velocity="4.36332"/>
  </joint>

  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0 0 0.27" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.91986" upper="1.22173" effort="0" velocity="4.36332"/>
  </joint>

  <joint name="joint_4" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="0 0 0.07" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-2.79253" upper="2.79253" effort="0" velocity="5.58505"/>
  </joint>

  <joint name="joint_5" type="revolute">
    <parent link="link_4"/>
    <child link="link_5"/>
    <origin xyz="0.302 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.094395" upper="2.094395" effort="0" velocity="5.58505"/>
  </joint>

  <joint name="joint_6" type="revolute">
    <parent link="link_5"/>
    <child link="link_6"/>
    <origin xyz="0.072 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-6.98132" upper="6.98132" effort="0" velocity="7.33038"/>
  </joint>

  <joint name="joint_6-flange" type="fixed">
    <parent link="link_6"/>
    <child link="flange"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="flange-tool0" type="fixed">
    <parent link="flange"/>
    <child link="tool0"/>
    <origin xyz="0 0 0" rpy="0 1.5707963267948966 0"/>
  </joint>
</robot>
