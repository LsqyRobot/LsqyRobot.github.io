<?xml version="1.0" encoding="UTF-8"?>
<!--
  Deterministic, original model for Robotics Workbench Tool 03.
  It is intentionally small but exercises a branched URDF tree, every joint
  type supported by the viewer, mimic coupling, primitive geometry, and a
  relative mesh path.
-->
<robot name="inspection_arm_demo">
  <material name="workbench_dark">
    <color rgba="0.10 0.16 0.20 1"/>
  </material>
  <material name="workbench_mint">
    <color rgba="0.25 0.78 0.66 1"/>
  </material>
  <material name="workbench_blue">
    <color rgba="0.20 0.48 0.82 1"/>
  </material>
  <material name="workbench_orange">
    <color rgba="0.91 0.53 0.22 1"/>
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.18" length="0.12"/>
      </geometry>
      <material name="workbench_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.18" length="0.12"/>
      </geometry>
    </collision>
  </link>

  <link name="pedestal_link">
    <visual>
      <origin xyz="0 0 0.11" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.095" length="0.22"/>
      </geometry>
      <material name="workbench_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.11" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.095" length="0.22"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_to_pedestal" type="fixed">
    <parent link="base_link"/>
    <child link="pedestal_link"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
  </joint>

  <link name="upper_arm_link">
    <visual>
      <origin xyz="0 0 0.24" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.12 0.48"/>
      </geometry>
      <material name="workbench_mint"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.24" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.12 0.48"/>
      </geometry>
    </collision>
  </link>

  <joint name="shoulder" type="revolute">
    <parent link="pedestal_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0.22" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.40" upper="1.40" effort="60" velocity="1.50"/>
  </joint>

  <link name="slider_carriage_link">
    <visual>
      <origin xyz="0.09 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.18 0.14 0.10"/>
      </geometry>
      <material name="workbench_orange"/>
    </visual>
    <collision>
      <origin xyz="0.09 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.18 0.14 0.10"/>
      </geometry>
    </collision>
  </link>

  <joint name="linear_slide" type="prismatic">
    <parent link="upper_arm_link"/>
    <child link="slider_carriage_link"/>
    <origin xyz="0 0 0.48" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.08" upper="0.24" effort="120" velocity="0.30"/>
  </joint>

  <link name="wrist_link">
    <visual>
      <origin xyz="0.075 0 0" rpy="0 1.5707963267948966 0"/>
      <geometry>
        <cylinder radius="0.055" length="0.15"/>
      </geometry>
      <material name="workbench_blue"/>
    </visual>
    <collision>
      <origin xyz="0.075 0 0" rpy="0 1.5707963267948966 0"/>
      <geometry>
        <cylinder radius="0.055" length="0.15"/>
      </geometry>
    </collision>
  </link>

  <joint name="wrist_spin" type="continuous">
    <parent link="slider_carriage_link"/>
    <child link="wrist_link"/>
    <origin xyz="0.18 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="15" velocity="2.50"/>
  </joint>

  <link name="tool_head_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/tool-head.stl" scale="1 1 1"/>
      </geometry>
      <material name="workbench_mint"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/tool-head.stl" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>

  <joint name="wrist_to_tool" type="fixed">
    <parent link="wrist_link"/>
    <child link="tool_head_link"/>
    <origin xyz="0.15 0 0" rpy="0 0 0"/>
  </joint>

  <link name="left_finger_link">
    <visual>
      <origin xyz="0.045 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.09 0.018 0.026"/>
      </geometry>
      <material name="workbench_orange"/>
    </visual>
    <collision>
      <origin xyz="0.045 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.09 0.018 0.026"/>
      </geometry>
    </collision>
  </link>

  <joint name="gripper_master" type="revolute">
    <parent link="tool_head_link"/>
    <child link="left_finger_link"/>
    <origin xyz="0.075 0.055 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="0.55" effort="5" velocity="1.20"/>
  </joint>

  <link name="right_finger_link">
    <visual>
      <origin xyz="0.045 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.09 0.018 0.026"/>
      </geometry>
      <material name="workbench_orange"/>
    </visual>
    <collision>
      <origin xyz="0.045 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.09 0.018 0.026"/>
      </geometry>
    </collision>
  </link>

  <joint name="gripper_follower" type="revolute">
    <parent link="tool_head_link"/>
    <child link="right_finger_link"/>
    <origin xyz="0.075 -0.055 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <mimic joint="gripper_master" multiplier="-1" offset="0"/>
    <limit lower="-0.55" upper="0" effort="5" velocity="1.20"/>
  </joint>
</robot>
