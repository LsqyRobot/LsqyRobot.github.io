<?xml version="1.0"?>
<robot name="two_link_identification_demo">
  <link name="base_link"/>

  <link name="link1">
    <inertial>
      <origin xyz="0.30 0 0" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.020" ixy="0" ixz="0" iyy="0.180" iyz="0" izz="0.180"/>
    </inertial>
  </link>

  <joint name="shoulder" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.4" upper="2.4" effort="80" velocity="4"/>
  </joint>

  <link name="link2">
    <inertial>
      <origin xyz="0.25 0 0" rpy="0 0 0.20"/>
      <mass value="1.2"/>
      <inertia ixx="0.012" ixy="0.001" ixz="0" iyy="0.085" iyz="0" izz="0.090"/>
    </inertial>
  </link>

  <joint name="elbow" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0.60 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.6" upper="2.6" effort="45" velocity="5"/>
  </joint>

  <!-- A fixed payload exercises wrench propagation through fixed joints. -->
  <link name="tool_payload">
    <inertial>
      <origin xyz="0.08 0.01 0" rpy="0.1 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="0.0012" ixy="0" ixz="0" iyy="0.0018" iyz="0" izz="0.0020"/>
    </inertial>
  </link>

  <joint name="tool_fixed" type="fixed">
    <parent link="link2"/>
    <child link="tool_payload"/>
    <origin xyz="0.50 0 0" rpy="0 0 0"/>
  </joint>
</robot>
