<?xml version="1.0"?>
<robot name="floating_quadruped_example">
  <link name="base">
    <inertial><origin xyz="0 0 0"/><mass value="8.0"/>
      <inertia ixx="0.18" ixy="0" ixz="0" iyy="0.35" iyz="0" izz="0.42"/>
    </inertial>
  </link>
  <link name="fl_hip_link">
    <inertial><origin xyz="0 0 -0.025"/><mass value="0.35"/>
      <inertia ixx="0.0012" ixy="0" ixz="0" iyy="0.0010" iyz="0" izz="0.0009"/>
    </inertial>
  </link>
  <link name="fl_thigh">
    <inertial><origin xyz="0 0 -0.105"/><mass value="0.65"/>
      <inertia ixx="0.0040" ixy="0" ixz="0" iyy="0.0038" iyz="0" izz="0.0008"/>
    </inertial>
  </link>
  <link name="fl_shank">
    <inertial><origin xyz="0 0 -0.105"/><mass value="0.45"/>
      <inertia ixx="0.0028" ixy="0" ixz="0" iyy="0.0026" iyz="0" izz="0.0006"/>
    </inertial>
  </link>
  <link name="fl_foot">
    <inertial><origin xyz="0 0 -0.015"/><mass value="0.08"/>
      <inertia ixx="0.00015" ixy="0" ixz="0" iyy="0.00015" iyz="0" izz="0.00010"/>
    </inertial>
  </link>
  <joint name="fl_hip_abduction" type="revolute">
    <parent link="base"/><child link="fl_hip_link"/>
    <origin xyz="0.23 0.14 0"/><axis xyz="1 0 0"/>
    <limit lower="-0.8" upper="0.8" effort="80" velocity="12"/>
  </joint>
  <joint name="fl_hip_pitch" type="revolute">
    <parent link="fl_hip_link"/><child link="fl_thigh"/>
    <origin xyz="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="1.5" effort="80" velocity="12"/>
  </joint>
  <joint name="fl_knee" type="revolute">
    <parent link="fl_thigh"/><child link="fl_shank"/>
    <origin xyz="0 0 -0.21"/><axis xyz="0 1 0"/>
    <limit lower="-2.7" upper="0.0" effort="80" velocity="12"/>
  </joint>
  <joint name="fl_foot_fixed" type="fixed">
    <parent link="fl_shank"/><child link="fl_foot"/>
    <origin xyz="0 0 -0.21"/>
  </joint>
  <link name="fr_hip_link">
    <inertial><origin xyz="0 0 -0.025"/><mass value="0.35"/>
