  RowBox[{"jm0", "=", "0.002`"}], ";", 
  RowBox[{"jl0", "=", "0.018`"}], ";", 
  RowBox[{"k0", "=", "2000.`"}], ";", 
  RowBox[{"d0", "=", "1.`"}], ";", 
  RowBox[{
   RowBox[{"antiFrequency", "[", 
    RowBox[{"jl_", ",", "k_"}], "]"}], ":=", 
   FractionBox[
    SqrtBox[
     FractionBox["k", "jl"]], 
    RowBox[{"2", " ", "\[Pi]"}]]}], ";", 
  RowBox[{
   RowBox[{"resonanceFrequency", "[", 
    RowBox[{"jm_", ",", "jl_", ",", "k_"}], "]"}], ":=", 
   FractionBox[
    SqrtBox[
     RowBox[{"k", " ", 
      RowBox[{"(", 
       RowBox[{
        FractionBox["1", "jm"], "+", 
        FractionBox["1", "jl"]}], ")"}]}]], 
    RowBox[{"2", " ", "\[Pi]"}]]}], ";", 
  RowBox[{
   RowBox[{"motorTF", "[", 
    RowBox[{"f_", ",", "jm_", ",", "jl_", ",", "k_", ",", "d_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
