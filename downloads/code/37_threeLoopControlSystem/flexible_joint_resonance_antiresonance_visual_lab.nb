$CellContext`k$$]; $CellContext`fR$ = \
$CellContext`resonanceFrequency[$CellContext`jm$$, $CellContext`jl$$, \
$CellContext`k$$]; $CellContext`phaseDifference$ = 
         Mod[Arg[$CellContext`thetaM$/$CellContext`thetaL$] 180/Pi + 180, 
            360] - 180; $CellContext`interpretation$ = 
