$CellContext`jl$$, $CellContext`k$$, $CellContext`d$$]; \
$CellContext`energies$ = {(1/4) $CellContext`jm$$ $CellContext`omega$^2 
           Abs[$CellContext`thetaM$]^2, (1/
            4) $CellContext`jl$$ $CellContext`omega$^2 
           Abs[$CellContext`thetaL$]^2, (1/4) $CellContext`k$$ 
           Abs[$CellContext`thetaM$ - $CellContext`thetaL$]^2}; \
$CellContext`shares$ = $CellContext`energies$/Max[
           Total[$CellContext`energies$], 
           10^(-30)]; $CellContext`inputPower$ = (1/2) Re[
            Conjugate[
            I $CellContext`omega$ $CellContext`thetaM$]]; \
$CellContext`dampingLoss$ = (1/2) $CellContext`d$$ $CellContext`omega$^2 
          Abs[$CellContext`thetaM$ - $CellContext`thetaL$]^2; \
