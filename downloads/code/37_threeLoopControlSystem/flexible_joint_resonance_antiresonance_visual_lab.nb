     RowBox[{
      RowBox[{"a", "=", 
       RowBox[{"k", "+", 
        RowBox[{"d", " ", "s"}]}]}], ";", 
      RowBox[{"den", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"jm", " ", 
            SuperscriptBox["s", "2"]}], "+", "a"}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"jl", " ", 
            SuperscriptBox["s", "2"]}], "+", "a"}], ")"}]}], "-", 
        SuperscriptBox["a", "2"]}]}], ";", 
      FractionBox[
       RowBox[{
        RowBox[{"jl", " ", 
         SuperscriptBox["s", "2"]}], "+", "a"}], "den"]}]}], "]"}]}], ";", 
  RowBox[{
